# AI Prompt Injection and Jailbreak Detection Firewall Configuration

# Application Metadata
APP_NAME=AI Prompt Injection and Jailbreak Detection Firewall
ENVIRONMENT=development
DEBUG=true

# Database Configuration (SQLite local default, PostgreSQL in Docker)
DATABASE_URL=sqlite:///./firewall.db
# DATABASE_URL=postgresql://firewall_user:firewall_password@localhost:5432/firewall_db

# Security & JWT Authentication
JWT_SECRET_KEY=change-this-super-secret-key-in-production-minimum-32-chars-entropy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Detection & Risk Scoring Thresholds
DEFAULT_ML_THRESHOLD=0.70
RULE_BLOCK_THRESHOLD=0.80
REVIEW_THRESHOLD=0.50
SECURE_MODE=false

# LLM Gateway Settings
# Supported providers: mock | ollama | openai | rest
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REST_LLM_URL=
REST_LLM_METHOD=POST
LLM_TIMEOUT_SECONDS=15.0

# Ingestion & Privacy Controls
MAX_PROMPT_LENGTH=10000
MAX_BATCH_SIZE=50
LOG_FULL_PROMPTS=false

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80
